SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dms_lite
SPRING_DATASOURCE_USERNAME=dms
SPRING_DATASOURCE_PASSWORD=change-me

APP_JWT_SECRET=replace-with-strong-random-64-char-secret
APP_JWT_MINUTES=180
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_BUSINESS_ZONE=Asia/Ho_Chi_Minh
APP_DEMO_ENABLED=false
APP_DEMO_PASSWORD=Demo@2026

SPRING_RABBITMQ_USERNAME=dms
SPRING_RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password
GF_SECURITY_ADMIN_PASSWORD=change-me

VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEMO_MODE=false
VITE_DEMO_PASSWORD=Demo@2026
# Optional AI assistant provider. Keep real keys in .env or OS environment only.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=900

# Optional invoice PDF font overrides. Defaults auto-detect Arial/Segoe UI on Windows
# and DejaVu/Liberation Sans on Linux. Docker installs DejaVu automatically.
APP_INVOICE_PDF_FONT_REGULAR=
APP_INVOICE_PDF_FONT_BOLD=
